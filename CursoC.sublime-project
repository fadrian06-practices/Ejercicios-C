{
  "folders": [
    {
      "name": "Programación en C",
      "path": ".",
    }
  ],
  "settings": {
    "LSP": {
      "formatters": {
        "source.json.sublime": "LSP-json",
      },
    },
    "default_line_ending": "unix",
    "tab_size": 2,
    "translate_tabs_to_spaces": true,
    "ensure_newline_at_eof_on_save": true,
    "trim_trailing_white_space_on_save": "not_on_caret",
  },
  "build_systems": [
    {
      "name": "Eliminar todos los .exe de esta y todas las carpetas",
      "quiet": true,
      "working_dir": "$project_path",
      "windows": {
        "shell_cmd": "DEL /F /S /Q *.exe"
      },
    },
    {
      "name": "Compilar C",
      "shell_cmd": "gcc \"${file}\" -o \"${file_base_name}.exe\"",
      "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
      "working_dir": "${file_path}",
      "selector": "source.c",
      "quiet": true,
      "variants": [
        {
          "name": "Compilar y ejecutar C",
          "shell_cmd": "gcc \"${file}\" -o \"${file_base_name}.exe\" && \"${file_base_name}\"",
          "target": "terminus_exec",
          "cancel": "terminus_cancel_build",
          "timeit": false,
          "focus": true,
        }
      ]
    }
  ]
}
